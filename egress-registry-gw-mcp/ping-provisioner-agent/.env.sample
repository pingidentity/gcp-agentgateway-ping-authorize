# GCP project that hosts Agent Registry and the Agent Gateway.
# The agent uses Application Default Credentials (ADC) — no separate
# OAuth client credentials needed. When running on Cloud Run the service
# account attached to the revision provides the credentials automatically.
GOOGLE_CLOUD_PROJECT=

# Region where Agent Registry resources are registered (must match the
# location used in setup-agent-registry.sh).
GOOGLE_CLOUD_LOCATION=us-central1

# Port this service listens on (Cloud Run routes to the port specified
# in the Cloud Build --port flag; this value must match).
AGENT_PORT=3000

# Gemini model to use for agent reasoning.
GEMINI_MODEL=gemini-2.0-flash

# Agent Registry service names for the two MCP backends.
# These are set when you run setup-agent-registry.sh.
# Defaults match the names used in the setup script.
PINGONE_AIC_MCP_SERVICE_NAME=pingone-aic-mcp-server
ENTRA_MCP_SERVICE_NAME=entra-mcp-server

# Port this MCP server listens on (Cloud Run expects 8080)
MCP_SERVER_PORT=8080

# Microsoft Entra (Azure AD) tenant ID
AZURE_TENANT_ID=

# App registration client credentials (needs User.ReadWrite.All on Graph API)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Scopes required by the agent to call this MCP server
MCP_REQUIRED_SCOPES=pingone:provisioning

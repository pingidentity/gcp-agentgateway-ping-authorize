# Port the gRPC ext_proc server listens on (Cloud Run expects 8080)
SHIM_SERVER_PORT=8080

# PingAuthorize governance engine endpoint
PING_AUTHORIZE_URL=https://ping-authorize-demo.com/governance-engine

# Agent Gateway internal LB URL (used in WWW-Authenticate challenges)
MCP_SERVER_URL=https://agent-gateway.internal

# Set to true only in dev/test environments to skip TLS cert verification
PING_AUTHORIZE_SKIP_TLS_VERIFY=false

# Space-separated list of scopes required to call the MCP servers
MCP_REQUIRED_SCOPES=pingone:provisioning

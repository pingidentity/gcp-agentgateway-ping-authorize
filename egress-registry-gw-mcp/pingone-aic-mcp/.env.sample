# Port this MCP server listens on (Cloud Run expects 8080)
MCP_SERVER_PORT=8080

# PingOne AIC (ForgeRock Identity Cloud) tenant base URL
AIC_BASE_URL=https://openam-your-tenant.forgeblocks.com

# OAuth admin client for AIC management API (needs fr:idm:* scope)
AIC_ADMIN_CLIENT_ID=
AIC_ADMIN_CLIENT_SECRET=

# AIC realm path (default: alpha)
AIC_REALM=alpha

# Scopes required by the agent to call this MCP server
MCP_REQUIRED_SCOPES=pingone:provisioning
